# Required before a real DSPy call. Examples: openai/gpt-5-mini or ollama_chat/qwen3
GAME_ACCOUNTABILITY_AI_MODEL=

# Remote providers are disabled unless explicitly enabled.
GAME_ACCOUNTABILITY_AI_ALLOW_REMOTE=false

# OpenAI's standard environment variable. Never commit a real value.
OPENAI_API_KEY= your_api_key

# Optional compatibility override for a non-OpenAI provider or legacy setup.
GAME_ACCOUNTABILITY_AI_API_KEY=
GAME_ACCOUNTABILITY_AI_BASE_URL=

GAME_ACCOUNTABILITY_AI_TEMPERATURE=0.0
GAME_ACCOUNTABILITY_AI_MAX_TOKENS=1200
